# Required by Fabric, Power BI, Microsoft Graph, and SharePoint examples.
FABRIC_TENANT_ID=<azure-tenant-id>
FABRIC_CLIENT_ID=<app-registration-client-id>
FABRIC_CLIENT_SECRET=<app-registration-client-secret>

# Required only by examples/database.py.
FABRIC_SQL_ENDPOINT=<server>.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=<database-name>

# Required only by examples/sharepoint.py.
SP_HOSTNAME=<tenant>.sharepoint.com
SP_SITE_PATH=/sites/<site-name>
